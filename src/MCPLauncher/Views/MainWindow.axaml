<Window
    x:Class="MCPLauncher.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    x:CompileBindings="False"
    Title="Fusebox"
    Icon="/Assets/fusebox.ico"
    Width="1380"
    Height="840"
    MinWidth="1000"
    MinHeight="640"
    Closing="OnClosing"
    Opened="OnOpened">
  <Grid RowDefinitions="64,*,36">
    <!-- Application bar -->
    <Border
        Grid.Row="0"
        Padding="18,0"
        Background="{DynamicResource PanelBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
        <Image
            Width="34"
            Height="34"
            Source="/Assets/fusebox-icon.png"
            Stretch="Uniform" />

        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="Fusebox" />
          <TextBlock Classes="muted" FontSize="11" Text="Local MCP server control" />
        </StackPanel>

        <Button
            Grid.Column="3"
            Classes="copper"
            Command="{Binding OpenConfigurationCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <iconPacks:PackIconLucide
                Width="15"
                Height="15"
                Kind="FileCog"
                VerticalAlignment="Center" />
            <TextBlock Text="Open configuration" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button
            Grid.Column="4"
            Margin="8,0,0,0"
            Command="{Binding RefreshCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <iconPacks:PackIconLucide
                Width="15"
                Height="15"
                Kind="RefreshCw"
                VerticalAlignment="Center" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Border
            Grid.Column="5"
            Width="34"
            Height="34"
            Margin="8,0,0,0"
            Background="{DynamicResource WarningSurfaceBrush}"
            BorderBrush="#5B4C2D"
            BorderThickness="1"
            CornerRadius="4"
            IsVisible="{Binding HasConfigurationWarning}"
            ToolTip.Tip="{Binding ConfigurationWarning}">
          <iconPacks:PackIconLucide
              Width="16"
              Height="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="{DynamicResource WarningBrush}"
              Kind="TriangleAlert" />
        </Border>
      </Grid>
    </Border>

    <!-- Main workspace -->
    <Grid Grid.Row="1" ColumnDefinitions="330,*">
      <!-- Server rail -->
      <Border
          Grid.Column="0"
          Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,1,0">
        <Grid RowDefinitions="58,*">
          <Grid
              Grid.Row="0"
              Margin="18,0,14,0"
              ColumnDefinitions="*,Auto"
              VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="eyebrow" Text="SERVERS" />
              <TextBlock
                  Margin="0,3,0,0"
                  Classes="muted"
                  FontSize="11"
                  Text="{Binding ServerCountDisplay}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="icon"
                Command="{Binding OpenConfigurationCommand}"
                ToolTip.Tip="Open configuration">
              <iconPacks:PackIconLucide
                  Width="16"
                  Height="16"
                  Kind="Plus" />
            </Button>
          </Grid>

          <Grid Grid.Row="1">
            <ListBox
                x:Name="ServerList"
                Classes="server-list"
                IsVisible="{Binding HasServers}"
                ItemsSource="{Binding Servers}"
                SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border
                      Padding="10,8"
                      BorderBrush="Transparent"
                      BorderThickness="2,0,0,0">
                    <Grid ColumnDefinitions="32,*,Auto" RowDefinitions="Auto,Auto,Auto">
                      <Border
                          Grid.RowSpan="2"
                          Width="25"
                          Height="25"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Background="#171A17"
                          BorderBrush="{DynamicResource BorderStrongBrush}"
                          BorderThickness="1"
                          CornerRadius="4">
                        <iconPacks:PackIconLucide
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource CopperBrush}"
                            Kind="Server" />
                      </Border>

                      <TextBlock
                          Grid.Column="1"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Text="{Binding Title}" />

                      <StackPanel
                          Grid.Column="2"
                          Margin="10,0,0,0"
                          Orientation="Horizontal"
                          Spacing="6"
                          VerticalAlignment="Center">
                        <Border
                            Classes="status-dot"
                            Classes.failed="{Binding IsFailed}"
                            Classes.running="{Binding IsRunning}"
                            Classes.transitioning="{Binding IsTransitioning}" />
                        <TextBlock
                            Classes="status-text"
                            Classes.failed="{Binding IsFailed}"
                            Classes.running="{Binding IsRunning}"
                            Classes.transitioning="{Binding IsTransitioning}"
                            FontSize="11"
                            Text="{Binding StateDisplay}" />
                      </StackPanel>

                      <StackPanel
                          Grid.Row="1"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Margin="0,4,0,0"
                          Orientation="Horizontal"
                          Spacing="8">
                        <TextBlock Classes="muted" FontSize="11" Text="{Binding Id}" />
                        <TextBlock Classes="secondary" FontSize="11" Text="{Binding PortDisplay}" />
                      </StackPanel>

                      <StackPanel
                          Grid.Row="2"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Margin="0,6,0,0"
                          IsVisible="{Binding HasServerNotice}">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource WarningBrush}"
                            Text="{Binding PendingChangesDisplay}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource FaultBrush}"
                            MaxLines="2"
                            Text="{Binding ConfigurationErrorDisplay}"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel
                Margin="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                Spacing="9">
              <Border
                  Width="42"
                  Height="42"
                  HorizontalAlignment="Center"
                  Background="#241F1A"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
                <iconPacks:PackIconLucide
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource CopperBrush}"
                    Kind="ServerCog" />
              </Border>
              <TextBlock
                  HorizontalAlignment="Center"
                  FontSize="16"
                  FontWeight="SemiBold"
                  Text="No servers configured" />
              <TextBlock
                  MaxWidth="245"
                  Classes="secondary"
                  FontSize="12"
                  Text="Add a server in the configuration file, then refresh Fusebox."
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
              <Button
                  HorizontalAlignment="Center"
                  Classes="copper"
                  Command="{Binding OpenConfigurationCommand}"
                  Content="Open configuration" />
            </StackPanel>
          </Grid>

        </Grid>
      </Border>

      <!-- Selected server workspace -->
      <Grid
          Grid.Column="1"
          Margin="20"
          RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock
                  FontSize="25"
                  FontWeight="SemiBold"
                  Text="{Binding SelectedServer.Title, FallbackValue=Select a server}" />
              <StackPanel
                  Margin="2,3,0,0"
                  Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center">
                <Border
                    Classes="status-dot"
                    Classes.failed="{Binding SelectedServer.IsFailed}"
                    Classes.running="{Binding SelectedServer.IsRunning}"
                    Classes.transitioning="{Binding SelectedServer.IsTransitioning}" />
                <TextBlock
                    Classes="status-text"
                    Classes.failed="{Binding SelectedServer.IsFailed}"
                    Classes.running="{Binding SelectedServer.IsRunning}"
                    Classes.transitioning="{Binding SelectedServer.IsTransitioning}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedServer.StateDisplay}" />
              </StackPanel>
            </StackPanel>
            <TextBlock
                Margin="0,4,0,0"
                Classes="secondary"
                FontSize="12"
                HorizontalAlignment="Left"
                MaxWidth="640"
                Text="{Binding SelectedServer.Description}"
                TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel
              Grid.Column="1"
              Margin="18,0,0,0"
              HorizontalAlignment="Right"
              Orientation="Horizontal"
              Spacing="7"
              VerticalAlignment="Top">
            <Button
                Classes="start"
                Command="{Binding StartCommand}"
                CommandParameter="{Binding SelectedServer}"
                IsEnabled="{Binding SelectedServer.CanStart}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <iconPacks:PackIconLucide
                    Width="15"
                    Height="15"
                    Kind="Play"
                    VerticalAlignment="Center" />
                <TextBlock Text="Start" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button
                Classes="stop"
                Command="{Binding StopCommand}"
                CommandParameter="{Binding SelectedServer}"
                IsEnabled="{Binding SelectedServer.CanStop}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <iconPacks:PackIconLucide
                    Width="15"
                    Height="15"
                    Kind="Square"
                    VerticalAlignment="Center" />
                <TextBlock Text="Stop" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button
                Classes="restart"
                Command="{Binding RestartCommand}"
                CommandParameter="{Binding SelectedServer}"
                IsEnabled="{Binding SelectedServer.CanRestart}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <iconPacks:PackIconLucide
                    Width="15"
                    Height="15"
                    Kind="RotateCcw"
                    VerticalAlignment="Center" />
                <TextBlock Text="Restart" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,18,0,14"
            Classes="card"
            Padding="14,11">
          <Grid ColumnDefinitions="2.2*,1*,1*,1*">
            <StackPanel>
              <TextBlock Classes="eyebrow" Text="COMMAND" />
              <TextBlock
                  Margin="0,4,12,0"
                  Classes="secondary"
                  FontFamily="Cascadia Mono,Consolas,monospace"
                  FontSize="11"
                  MaxLines="1"
                  Text="{Binding SelectedServer.CommandDisplay}"
                  TextTrimming="CharacterEllipsis"
                  ToolTip.Tip="{Binding SelectedServer.CommandDisplay}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="eyebrow" Text="PROCESS ID" />
              <TextBlock
                  Margin="0,4,0,0"
                  Classes="secondary"
                  FontFamily="Cascadia Mono,Consolas,monospace"
                  FontSize="11"
                  Text="{Binding SelectedServer.ProcessIdDisplay}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="eyebrow" Text="PORT" />
              <TextBlock
                  Margin="0,4,0,0"
                  Classes="secondary"
                  FontFamily="Cascadia Mono,Consolas,monospace"
                  FontSize="11"
                  Text="{Binding SelectedServer.PortValueDisplay}" />
            </StackPanel>
            <StackPanel Grid.Column="3">
              <TextBlock Classes="eyebrow" Text="RUNS" />
              <TextBlock
                  Margin="0,4,0,0"
                  Classes="secondary"
                  FontFamily="Cascadia Mono,Consolas,monospace"
                  FontSize="11"
                  Text="{Binding SelectedServer.RunCountDisplay}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Classes="console">
          <Grid RowDefinitions="46,*">
            <Border
                Grid.Row="0"
                Padding="14,0"
                Background="#141815"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border
                      Width="6"
                      Height="6"
                      Background="{DynamicResource RunningBrush}"
                      CornerRadius="3" />
                  <TextBlock Classes="eyebrow" Text="LIVE OUTPUT" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                  <TextBlock
                      Classes="muted"
                      FontSize="11"
                      Text="RUN HISTORY"
                      VerticalAlignment="Center" />
                  <ComboBox
                      Width="250"
                      DisplayMemberBinding="{Binding DisplayName}"
                      ItemsSource="{Binding SelectedServer.Runs}"
                      SelectedItem="{Binding SelectedServer.SelectedRun, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <TextBox
                  Padding="16,14"
                  AcceptsReturn="True"
                  Background="Transparent"
                  BorderThickness="0"
                  FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                  FontSize="12"
                  Foreground="#D7D8D1"
                  IsReadOnly="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Text="{Binding SelectedServer.SelectedRun.Output}"
                  TextWrapping="NoWrap" />
              <TextBlock
                  Margin="0,0,0,26"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Classes="muted"
                  FontSize="12"
                  IsVisible="{Binding SelectedServer.HasNoRuns}"
                  Text="Start this server to create its first run." />
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Status strip -->
    <Border
        Grid.Row="2"
        Padding="16,0"
        Background="#131714"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
        <Border
            Width="6"
            Height="6"
            Background="{DynamicResource CopperBrush}"
            CornerRadius="3" />
        <TextBlock
            Grid.Column="1"
            Margin="9,0,0,0"
            Classes="secondary"
            FontSize="11"
            Text="{Binding Status}" />
      </Grid>
    </Border>
  </Grid>
</Window>
