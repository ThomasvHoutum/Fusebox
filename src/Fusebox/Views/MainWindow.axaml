<Window
    x:Class="Fusebox.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:views="using:Fusebox.Views"
    x:CompileBindings="False"
    Title="Fusebox"
    Icon="/Assets/fusebox.ico"
    Width="1380"
    Height="840"
    MinWidth="1000"
    MinHeight="640"
    Closing="OnClosing"
    Opened="OnOpened">
  <Grid RowDefinitions="64,*,36">
    <Border
        Grid.Row="0"
        Padding="18,0"
        Background="{DynamicResource PanelBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
        <Image Width="34" Height="34" Source="/Assets/fusebox-icon.png" Stretch="Uniform" />
        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="Fusebox" />
          <TextBlock Classes="muted" FontSize="11" Text="Local MCP server control" />
        </StackPanel>
        <Button Grid.Column="3" Classes="copper" Command="{Binding OpenConfigurationCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <iconPacks:PackIconLucide Width="15" Height="15" Kind="FileCog" />
            <TextBlock Text="Open configuration" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <iconPacks:PackIconLucide Width="15" Height="15" Kind="RefreshCw" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
        <Border
            Grid.Column="5"
            Width="34"
            Height="34"
            Margin="8,0,0,0"
            Background="{DynamicResource WarningSurfaceBrush}"
            BorderBrush="#5B4C2D"
            BorderThickness="1"
            CornerRadius="4"
            IsVisible="{Binding HasConfigurationWarning}"
            ToolTip.Tip="{Binding ConfigurationWarning}">
          <iconPacks:PackIconLucide
              Width="16"
              Height="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="{DynamicResource WarningBrush}"
              Kind="TriangleAlert" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="330,*">
      <Border
          Grid.Column="0"
          Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,1,0">
        <Grid RowDefinitions="74,*">
          <Grid Grid.Row="0" Margin="12,8,12,6" ColumnDefinitions="*,Auto">
            <StackPanel>
              <ComboBox
                  Width="190"
                  HorizontalAlignment="Left"
                  DisplayMemberBinding="{Binding Title}"
                  ItemsSource="{Binding CatalogFilters}"
                  SelectedItem="{Binding SelectedCatalogFilter, Mode=TwoWay}"
                  ToolTip.Tip="Filter the catalog by servers or profiles." />
              <TextBlock
                  Margin="3,4,0,0"
                  Classes="muted"
                  FontSize="11"
                  Text="{Binding CatalogCountDisplay}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="icon"
                Command="{Binding OpenConfigurationCommand}"
                VerticalAlignment="Top"
                ToolTip.Tip="Open configuration">
              <iconPacks:PackIconLucide Width="16" Height="16" Kind="Plus" />
            </Button>
          </Grid>

          <Grid Grid.Row="1">
            <ListBox
                x:Name="CatalogList"
                Classes="server-list"
                IsVisible="{Binding HasVisibleNavigationItems}"
                ItemsSource="{Binding VisibleNavigationItems}"
                SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Border Padding="10,9" IsVisible="{Binding IsProfile}">
                      <Grid ColumnDefinitions="34,*,Auto" RowDefinitions="Auto,Auto">
                        <Border
                            Grid.RowSpan="2"
                            Width="27"
                            Height="27"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#2B241D"
                            BorderBrush="#735039"
                            BorderThickness="1"
                            CornerRadius="4">
                          <iconPacks:PackIconLucide
                              Width="15"
                              Height="15"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource CopperBrightBrush}"
                              Kind="Folder" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding Profile.Title}" />
                        <Border
                            Grid.Column="2"
                            Width="20"
                            Height="20"
                            Background="{DynamicResource WarningSurfaceBrush}"
                            CornerRadius="3"
                            IsVisible="{Binding Profile.HasWarnings}"
                            ToolTip.Tip="{Binding Profile.WarningDisplay}">
                          <iconPacks:PackIconLucide
                              Width="12"
                              Height="12"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource WarningBrush}"
                              Kind="TriangleAlert" />
                        </Border>
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,4,0,0"
                            Classes="muted"
                            FontSize="11"
                            Text="{Binding Profile.ServerCountDisplay}" />
                      </Grid>
                    </Border>

                    <Border Padding="10,8" IsVisible="{Binding IsServer}">
                      <Grid ColumnDefinitions="34,*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <Border
                            Grid.RowSpan="2"
                            Width="25"
                            Height="25"
                            HorizontalAlignment="Left"
                            Background="#171A17"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                          <iconPacks:PackIconLucide
                              Width="14"
                              Height="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource CopperBrush}"
                              Kind="Server" />
                        </Border>
                        <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Text="{Binding Server.Title}" />
                        <StackPanel Grid.Column="2" Margin="8,0,0,0" Orientation="Horizontal" Spacing="6">
                          <Border
                              Classes="status-dot"
                              Classes.failed="{Binding Server.IsFailed}"
                              Classes.running="{Binding Server.IsRunning}"
                              Classes.transitioning="{Binding Server.IsTransitioning}" />
                          <TextBlock
                              Classes="status-text"
                              Classes.failed="{Binding Server.IsFailed}"
                              Classes.running="{Binding Server.IsRunning}"
                              Classes.transitioning="{Binding Server.IsTransitioning}"
                              FontSize="11"
                              Text="{Binding Server.StateDisplay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                          <TextBlock Classes="muted" FontSize="11" Text="{Binding Server.Id}" />
                          <TextBlock Classes="secondary" FontSize="11" Text="{Binding Server.PortDisplay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            IsVisible="{Binding Server.HasServerNotice}">
                          <TextBlock FontSize="11" Foreground="{DynamicResource WarningBrush}" Text="{Binding Server.PendingChangesDisplay}" />
                          <TextBlock
                              FontSize="11"
                              Foreground="{DynamicResource FaultBrush}"
                              MaxLines="2"
                              Text="{Binding Server.ConfigurationErrorDisplay}"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel
                Margin="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding HasNoVisibleNavigationItems}"
                Spacing="9">
              <iconPacks:PackIconLucide
                  Width="28"
                  Height="28"
                  HorizontalAlignment="Center"
                  Foreground="{DynamicResource CopperBrush}"
                  Kind="ListFilter" />
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Nothing to show" />
              <TextBlock
                  MaxWidth="240"
                  Classes="secondary"
                  FontSize="12"
                  Text="Change the catalog filter or add entries in the configuration."
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <views:ServerWorkspaceView IsVisible="{Binding IsServerWorkspaceVisible}" />
        <views:ProfileWorkspaceView IsVisible="{Binding IsProfileWorkspaceVisible}" />
      </Grid>
    </Grid>

    <Border
        Grid.Row="2"
        Padding="16,0"
        Background="#131714"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
        <Border Width="6" Height="6" Background="{DynamicResource CopperBrush}" CornerRadius="3" />
        <TextBlock Grid.Column="1" Margin="9,0,0,0" Classes="secondary" FontSize="11" Text="{Binding Status}" />
      </Grid>
    </Border>
  </Grid>
</Window>
