<UserControl
    x:Class="Fusebox.Views.ServerWorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    x:CompileBindings="False">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="9">
          <TextBlock FontSize="25" FontWeight="SemiBold" Text="{Binding SelectedServer.Title}" />
          <StackPanel Margin="2,3,0,0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Border
                Classes="status-dot"
                Classes.failed="{Binding SelectedServer.IsFailed}"
                Classes.running="{Binding SelectedServer.IsRunning}"
                Classes.transitioning="{Binding SelectedServer.IsTransitioning}" />
            <TextBlock
                Classes="status-text"
                Classes.failed="{Binding SelectedServer.IsFailed}"
                Classes.running="{Binding SelectedServer.IsRunning}"
                Classes.transitioning="{Binding SelectedServer.IsTransitioning}"
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding SelectedServer.StateDisplay}" />
          </StackPanel>
        </StackPanel>
        <TextBlock
            Margin="0,4,0,0"
            Classes="secondary"
            FontSize="12"
            MaxWidth="640"
            Text="{Binding SelectedServer.Description}"
            TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal" Spacing="7">
        <Button Classes="start" Command="{Binding StartCommand}" CommandParameter="{Binding SelectedServer}" IsEnabled="{Binding SelectedServer.CanStart}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <iconPacks:PackIconLucide Width="15" Height="15" Kind="Play" />
            <TextBlock Text="Start" />
          </StackPanel>
        </Button>
        <Button Classes="stop" Command="{Binding StopCommand}" CommandParameter="{Binding SelectedServer}" IsEnabled="{Binding SelectedServer.CanStop}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <iconPacks:PackIconLucide Width="15" Height="15" Kind="Square" />
            <TextBlock Text="Stop" />
          </StackPanel>
        </Button>
        <Button Classes="restart" Command="{Binding RestartCommand}" CommandParameter="{Binding SelectedServer}" IsEnabled="{Binding SelectedServer.CanRestart}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <iconPacks:PackIconLucide Width="15" Height="15" Kind="RotateCcw" />
            <TextBlock Text="Restart" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Margin="0,18,0,14" Classes="card" Padding="14,11">
      <Grid ColumnDefinitions="2.2*,1*,1*,1*">
        <StackPanel>
          <TextBlock Classes="eyebrow" Text="COMMAND" />
          <TextBlock
              Margin="0,4,12,0"
              Classes="secondary"
              FontFamily="Cascadia Mono,Consolas,monospace"
              FontSize="11"
              MaxLines="1"
              Text="{Binding SelectedServer.CommandDisplay}"
              TextTrimming="CharacterEllipsis"
              ToolTip.Tip="{Binding SelectedServer.CommandDisplay}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="eyebrow" Text="PROCESS ID" />
          <TextBlock Margin="0,4,0,0" Classes="secondary" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11" Text="{Binding SelectedServer.ProcessIdDisplay}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Classes="eyebrow" Text="PORT" />
          <TextBlock Margin="0,4,0,0" Classes="secondary" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11" Text="{Binding SelectedServer.PortValueDisplay}" />
        </StackPanel>
        <StackPanel Grid.Column="3">
          <TextBlock Classes="eyebrow" Text="RUNS" />
          <TextBlock Margin="0,4,0,0" Classes="secondary" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11" Text="{Binding SelectedServer.RunCountDisplay}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Classes="console">
      <Grid RowDefinitions="46,*">
        <Border Grid.Row="0" Padding="14,0" Background="#141815" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Border Width="6" Height="6" Background="{DynamicResource RunningBrush}" CornerRadius="3" />
              <TextBlock Classes="eyebrow" Text="LIVE OUTPUT" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="muted" FontSize="11" Text="RUN HISTORY" VerticalAlignment="Center" />
              <ComboBox
                  Width="250"
                  DisplayMemberBinding="{Binding DisplayName}"
                  ItemsSource="{Binding SelectedServer.Runs}"
                  SelectedItem="{Binding SelectedServer.SelectedRun, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <TextBox
              Padding="16,14"
              AcceptsReturn="True"
              Background="Transparent"
              BorderThickness="0"
              FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
              FontSize="12"
              Foreground="#D7D8D1"
              IsReadOnly="True"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              Text="{Binding SelectedServer.SelectedRun.Output}"
              TextWrapping="NoWrap" />
          <TextBlock
              Margin="0,0,0,26"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Classes="muted"
              FontSize="12"
              IsVisible="{Binding SelectedServer.HasNoRuns}"
              Text="Start this server to create its first run." />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
